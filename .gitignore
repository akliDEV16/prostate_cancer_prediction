# ==========================================

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# ==========================================
# DONNÉES DU PROJET
# ==========================================

# Données originales
data/raw/

# Données transformées
data/processed/

# Données finales
data/final/

# ==========================================
